# =============================================================================
# SHE Scan / Baddiez - Supabase Database & Auth Configuration Template
# Copy this file to .env and fill in your actual Supabase credentials.
# =============================================================================

# Supabase Project URL
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public Key
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> "anon" "public"
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================================================
# Optional Backend Configuration (Supabase Edge Functions)
# =============================================================================
# Used by edge functions in supabase/functions/ (extract-label, explain-verdict)
# Set in Supabase via CLI: supabase secrets set GEMINI_API_KEY=<your-key>
# GEMINI_API_KEY=your-gemini-api-key
